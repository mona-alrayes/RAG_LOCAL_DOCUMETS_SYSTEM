# Deployment mode: cloud | local
RAG_DEPLOYMENT_MODE=local
# Answer generation is configured separately from document processing.
RAG_GENERATION_PROFILE=hybrid_local

# Shared secret used by trusted internal clients.
# Replace this value in the real environment.
INTERNAL_API_KEY=change-me
LARAVEL_INTERNAL_BASE_URL=http://localhost:8000
PROCESSING_CALLBACK_SECRET=change-me-different-from-internal-api-key
PROCESSING_CALLBACK_TIMEOUT_SECONDS=5
PROCESSING_CALLBACK_MAX_ATTEMPTS=3
PROCESSING_CALLBACK_RETRY_DELAY_SECONDS=0.25

# Required only when RAG_DEPLOYMENT_MODE=local.
# Remove or comment this setting when using cloud mode.
LOCAL_AI_TOPOLOGY=host_native
# resolver choose [CUDA , ROCm , XPU , MPS , CPU]
LOCAL_DEVICE=auto
# Accelator = FP16 , CPU = FP32
LOCAL_DTYPE=auto
# Qdrant connection and processing collections.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_CLOUD_COLLECTION=rag_documents_cloud
QDRANT_HYBRID_LOCAL_COLLECTION=rag_documents_hybrid_local


# LlamaParse (both profiles): https://cloud.llamaindex.ai/ -> API Keys
LLAMA_CLOUD_API_KEY=

CHUNK_SIZE=800
CHUNK_OVERLAP=80

# Jina embeddings/reranking: https://jina.ai/api-dashboard/
JINAAI_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens
# Grant the token permission to make calls to Inference Providers.
HF_TOKEN=

# Cloud LLM generation.
CLOUD_LLM_MODEL=Qwen/Qwen3.5-9B
RAG_GENERATION_TEMPERATURE=0.2

# Local Ollama answer generation.
OLLAMA_BASE_URL=http://127.0.0.1:11435
LOCAL_LLM_MODEL=qwen3.5:4b
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
# Examples: 0 = unload Ollama model immediately, unload the model after 30s, 2m, 5m  
# The goal is to save resources when the model is not in use, but also to avoid the overhead of reloading the model too frequently.
OLLAMA_KEEP_ALIVE=5m


# Cloud dense embedding model.
CLOUD_EMBED_MODEL=jina-embeddings-v3

# Cloud multilingual reranker model.
CLOUD_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Cloud embedding batching and retry controls.
EMBED_BATCH_SIZE=6
WAIT_BETWEEN_BATCHES=3
RATE_LIMIT_RETRY_WAIT=30
MAX_RETRIES=5

LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Local heavy-model lifecycle safeguards.
LOCAL_MIN_AVAILABLE_MEMORY_RATIO=0.15
LOCAL_AI_MAX_CONCURRENCY=1
LOCAL_EMBED_KEEP_ALIVE_SECONDS=0
LOCAL_RERANK_KEEP_ALIVE_SECONDS=0

# Local generation memory budget (restart FastAPI after editing).
LOCAL_LLM_NUM_CTX=8192
RAG_GENERATION_MAX_TOKENS=768
# Path to the tokenizer.json matching LOCAL_LLM_MODEL. Without it a conservative
# UTF-8 byte bound is used and large prompts may be rejected.
LOCAL_LLM_TOKENIZER_PATH=
LOCAL_SYSTEM_RESERVE_GIB=2
LOCAL_EMBEDDING_HEADROOM_GIB=2
LOCAL_RERANKER_HEADROOM_GIB=2
LOCAL_LLM_HEADROOM_GIB=2
