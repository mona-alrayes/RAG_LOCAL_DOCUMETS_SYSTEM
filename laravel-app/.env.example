APP_NAME="نظام الاستعلام الذكي عن الوثائق"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_FORWARD_PORT=3306
DB_DATABASE=rag_local_documents
DB_USERNAME=rag_app
DB_PASSWORD=change-me-local
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ROOT_PASSWORD=change-root-password-local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360

# Document processing queues
PROCESSING_QUEUE=default
LOCAL_AI_QUEUE=ai-local
LOCAL_AI_QUEUE_CONCURRENCY=1

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379

# Gmail SMTP: see README section 8.
# Keep log until real Gmail credentials are configured in your private .env.
# Then use MAIL_MAILER=smtp, MAIL_SCHEME=smtp, MAIL_HOST=smtp.gmail.com,
# MAIL_PORT=587, and the same Gmail address for username and from address.
# MAIL_PASSWORD must be a Google App Password, not the account password.
# Create one: https://myaccount.google.com/apppasswords
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DOCUMENT_UPLOAD_MAX_SIZE_KB=10240
DOCUMENT_SECURITY_SCAN_ENABLED=true

# ClamAV on-demand security scan
CLAMAV_SCAN_MODE=on_demand_cli
CLAMAV_SCAN_QUEUE=security-scan
CLAMAV_SCAN_CONCURRENCY=1
CLAMAV_SCAN_TIMEOUT=300
CLAMAV_SIGNATURE_DIR=/var/lib/clamav
CLAMAV_FAIL_CLOSED=true

QDRANT_FORWARD_PORT=6333

# Local Demo heavy-resource coordination
LOCAL_HEAVY_RESOURCE_LOCK_ENABLED=true
LOCAL_HEAVY_RESOURCE_LOCK_KEY=rag:local:heavy-resource
LOCAL_HEAVY_RESOURCE_LOCK_TIMEOUT=600
LOCAL_HEAVY_RESOURCE_LOCK_WAIT_TIMEOUT=10
LOCAL_HEAVY_RESOURCE_LOCK_RETRY_INTERVAL_MS=250

# Internal FastAPI AI service
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_INTERNAL_API_KEY=change-me
AI_SERVICE_CONNECT_TIMEOUT=10
AI_SERVICE_TIMEOUT=300
AI_SERVICE_PROCESS_DOCUMENT_TIMEOUT=300
PROCESSING_CALLBACK_SECRET=change-me-different-from-ai-service-key
